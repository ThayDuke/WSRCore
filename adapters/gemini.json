{
  "schemaVersion": 3,
  "adapterId": "gemini",
  "runtimeFamily": "gemini-family",
  "enabled": true,
  "supportLevel": "secondary-compatible",
  "roots": {
    "config": {
      "default": "~/.gemini",
      "environmentVariable": "GEMINI_HOME",
      "requiresExplicit": false
    }
  },
  "discoveryPrecedence": [
    "~/.gemini/GEMINI.md"
  ],
  "artifactMappings": [
    {
      "artifactId": "global-skill-taste-ref",
      "artifactType": "document",
      "root": "config",
      "relativePath": "config/skills",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactId": "global-skill-liquid-glass-readme",
      "artifactType": "document",
      "root": "config",
      "relativePath": "config/skills",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactId": "global-skill-stitch-design",
      "artifactType": "document",
      "root": "config",
      "relativePath": "config/skills",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactId": "global-skill-dec-dev-openai",
      "artifactType": "document",
      "root": "config",
      "relativePath": "config/skills",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactId": "global-skill-liquid-glass-web-doc",
      "artifactType": "document",
      "root": "config",
      "relativePath": "config/skills",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactType": "rule",
      "root": "config",
      "relativePath": "wsr/rules",
      "stripTopLevel": true,
      "native": false
    },
    {
      "artifactType": "workflow",
      "root": "config",
      "relativePath": "config/global_workflows",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactType": "skill",
      "root": "config",
      "relativePath": "config/skills",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactType": "script",
      "root": "config",
      "relativePath": "config/wsr/scripts",
      "stripTopLevel": true,
      "native": false
    }
  ],
  "router": {
    "root": "config",
    "path": "GEMINI.md",
    "family": "gemini-family",
    "native": true
  },
  "state": {
    "root": "config",
    "path": ".wsr-active.json"
  },
  "capabilities": {
    "nativeInstructions": true,
    "nativeSlashWorkflows": true,
    "nativeProgressiveSkills": true,
    "restartAfterRouterChange": true,
    "goalSupport": "unsupported",
    "goalEntrypoint": "none",
    "subagentDispatch": false,
    "receiptContract": "goal-task-v1",
    "maxParallelTasks": 1,
    "maxRuleChars": 12000,
    "maxWorkflowChars": 12000
  },
  "legacyRoots": [
    "~/.gemini/workflows",
    "~/.gemini/skills"
  ],
  "unsupportedFeatures": []
}
