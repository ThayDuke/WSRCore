{
  "schemaVersion": 3,
  "adapterId": "generic",
  "runtimeFamily": "generic",
  "enabled": true,
  "supportLevel": "secondary-emulated",
  "roots": {
    "config": {
      "default": null,
      "environmentVariable": null,
      "requiresExplicit": true
    }
  },
  "discoveryPrecedence": [
    "<explicit-root>/AGENTS.md"
  ],
  "artifactMappings": [
    {
      "artifactId": "global-skill-liquid-glass-readme",
      "artifactType": "document",
      "root": "config",
      "relativePath": "skills",
      "stripTopLevel": true,
      "native": false
    },
    {
      "artifactId": "global-skill-stitch-design",
      "artifactType": "document",
      "root": "config",
      "relativePath": "skills",
      "stripTopLevel": true,
      "native": false
    },
    {
      "artifactId": "global-skill-dec-dev-openai",
      "artifactType": "document",
      "root": "config",
      "relativePath": "skills",
      "stripTopLevel": true,
      "native": false
    },
    {
      "artifactId": "global-skill-liquid-glass-web-doc",
      "artifactType": "document",
      "root": "config",
      "relativePath": "skills",
      "stripTopLevel": true,
      "native": false
    },
    {
      "artifactType": "rule",
      "root": "config",
      "relativePath": "wsr/rules",
      "stripTopLevel": true,
      "native": false
    },
    {
      "artifactType": "workflow",
      "root": "config",
      "relativePath": "workflows",
      "stripTopLevel": true,
      "native": false
    },
    {
      "artifactType": "skill",
      "root": "config",
      "relativePath": "skills",
      "stripTopLevel": true,
      "native": false
    },
    {
      "artifactType": "script",
      "root": "config",
      "relativePath": "scripts",
      "stripTopLevel": true,
      "native": false
    }
  ],
  "router": {
    "root": "config",
    "path": "AGENTS.md",
    "family": "generic",
    "native": false
  },
  "state": {
    "root": "config",
    "path": ".wsr-active.json"
  },
  "capabilities": {
    "nativeInstructions": false,
    "nativeSlashWorkflows": false,
    "nativeProgressiveSkills": false,
    "restartAfterRouterChange": true,
    "goalSupport": "emulated",
    "goalEntrypoint": "fallback-single-agent",
    "subagentDispatch": false,
    "receiptContract": "goal-task-v1",
    "maxParallelTasks": 1
  },
  "legacyRoots": [],
  "unsupportedFeatures": [
    "native-discovery"
  ]
}
