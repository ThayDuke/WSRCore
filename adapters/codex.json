{
  "schemaVersion": 3,
  "adapterId": "codex",
  "runtimeFamily": "codex",
  "enabled": true,
  "supportLevel": "primary-native",
  "roots": {
    "config": {
      "default": "~/.codex",
      "environmentVariable": "CODEX_HOME",
      "requiresExplicit": false
    },
    "skills": {
      "default": "~/.agents/skills",
      "environmentVariable": null,
      "requiresExplicit": false
    }
  },
  "discoveryPrecedence": [
    "~/.codex/AGENTS.override.md",
    "~/.codex/AGENTS.md",
    "<workspace>/AGENTS.override.md",
    "<workspace>/AGENTS.md"
  ],
  "artifactMappings": [
    {
      "artifactId": "global-skill-liquid-glass-readme",
      "artifactType": "document",
      "root": "skills",
      "relativePath": "",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactId": "global-skill-stitch-design",
      "artifactType": "document",
      "root": "skills",
      "relativePath": "",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactId": "global-skill-dec-dev-openai",
      "artifactType": "document",
      "root": "skills",
      "relativePath": "",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactId": "global-skill-liquid-glass-web-doc",
      "artifactType": "document",
      "root": "skills",
      "relativePath": "",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactType": "rule",
      "root": "config",
      "relativePath": "wsr/rules",
      "stripTopLevel": true,
      "native": false
    },
    {
      "artifactType": "workflow",
      "root": "config",
      "relativePath": "wsr/workflows",
      "stripTopLevel": true,
      "native": false
    },
    {
      "artifactType": "skill",
      "root": "skills",
      "relativePath": "",
      "stripTopLevel": true,
      "native": true
    },
    {
      "artifactType": "script",
      "root": "config",
      "relativePath": "wsr/scripts",
      "stripTopLevel": true,
      "native": false
    }
  ],
  "router": {
    "root": "config",
    "path": "AGENTS.md",
    "family": "codex",
    "native": true
  },
  "state": {
    "root": "config",
    "path": "wsr/.wsr-active.json"
  },
  "capabilities": {
    "nativeInstructions": true,
    "nativeSlashWorkflows": false,
    "nativeProgressiveSkills": true,
    "restartAfterRouterChange": true,
    "goalSupport": "native",
    "goalEntrypoint": "native-goal",
    "subagentDispatch": true,
    "receiptContract": "goal-task-v1",
    "maxParallelTasks": 4,
    "maxInstructionBytes": 32768
  },
  "legacyRoots": [
    "~/.codex/workflows",
    "~/.codex/skills"
  ],
  "unsupportedFeatures": [
    "native-custom-slash-workflows"
  ]
}
