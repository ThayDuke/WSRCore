{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WSRManifestV2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "packageName": {
      "type": "string",
      "const": "WSR-Core"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
    },
    "buildId": {
      "type": "string",
      "pattern": "^WSR-CORE-\\d+\\.\\d+(?:\\.\\d+)?-(REVIEW|RELEASE-CANDIDATE|RELEASE)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "Review",
        "ReleaseCandidate",
        "Released"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "canonicalLayout": {
      "type": "string",
      "enum": [
        ".agents"
      ]
    },
    "compatibilityLayouts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [".agents", ".codex", ".gemini"]
      }
    },
    "minimumPython": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "policySource": {
      "type": "string",
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$"
    },
    "checksumsFile": {
      "type": "string",
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$"
    },
    "contextFile": {
      "type": "string",
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$"
    },
    "cleanWhitelist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$"
      }
    },
    "packageExclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$"
      }
    },
    "adapters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^adapters/[a-z0-9-]+\\.json$"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "source": {
            "type": "string",
            "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "policy",
              "rule",
              "workflow",
              "skill",
              "script",
              "document",
              "generated",
              "test",
              "evidence"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "mutable": {
            "type": "boolean"
          },
          "deploy": {
            "type": "boolean"
          },
          "targets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["codex", "gemini", "antigravity", "claude", "cursor", "generic"]
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "encoding": {
            "type": "string",
            "enum": ["UTF-8"]
          }
        },
        "required": [
          "id",
          "source",
          "type",
          "required",
          "mutable",
          "deploy",
          "targets",
          "owner"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "packageName",
    "version",
    "buildId",
    "status",
    "createdAt",
    "canonicalLayout",
    "compatibilityLayouts",
    "minimumPython",
    "policySource",
    "checksumsFile",
    "contextFile",
    "cleanWhitelist",
    "packageExclusions",
    "adapters",
    "artifacts"
  ],
  "additionalProperties": false
}
