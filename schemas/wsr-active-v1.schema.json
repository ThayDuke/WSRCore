{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WSRActiveMarkerV1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "adapterIdentity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
    },
    "buildId": {
      "type": "string",
      "pattern": "^WSR-CORE-\\d+\\.\\d+(?:\\.\\d+)?-(REVIEW|RELEASE-CANDIDATE|RELEASE)$"
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inventoryHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "routerHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "logicalRoots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "installTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "adapterIdentity",
    "packageVersion",
    "buildId",
    "manifestHash",
    "inventoryHash",
    "routerHash",
    "logicalRoots",
    "installTimestamp",
    "transactionId"
  ],
  "additionalProperties": false
}
