{
  "schemaVersion": 2,
  "buildId": "WSR-CORE-1.5.0-RELEASE",
  "contextTelemetry": {
    "everyResponse": true,
    "cases": [
      {"usedTokens": 200, "windowTokens": 1000, "expectedPercent": 20, "expectedState": "NORMAL"},
      {"usedTokens": 600, "windowTokens": 1000, "expectedPercent": 60, "expectedState": "WARNING"},
      {"usedTokens": 750, "windowTokens": 1000, "expectedPercent": 75, "expectedState": "HANDOFF_REQUIRED"},
      {"usedTokens": 850, "windowTokens": 1000, "expectedPercent": 85, "expectedState": "CRITICAL"}
    ]
  },
  "profiles": {
    "startup": {
      "roles": [
        "kernel",
        "command_index"
      ],
      "maxTokens": 1000
    },
    "command": {
      "requires": [
        "command-name"
      ]
    },
    "task": {
      "requires": [
        "command-name"
      ],
      "skillMode": "selected-only"
    },
    "resume": {
      "requires": [
        "session-file",
        "workspace-root"
      ],
      "maxTokens": 4000,
      "authorityPersistence": false
    },
    "diagnostic": {
      "explicitOnly": true
    }
  },
  "adapters": {
    "codex": {
      "router": "AGENTS.md",
      "skillRoot": "~/.agents/skills",
      "nativeSlashWorkflows": false
    },
    "antigravity": {
      "router": "GEMINI.md",
      "workflowRoot": "config/global_workflows",
      "skillRoot": "antigravity/skills",
      "maxChars": 12000
    }
  },
  "goal": {
    "authorized": [
      {"prompt": "/goal sửa audit", "source": "/goal", "objective": "sửa audit"},
      {"prompt": "  Goal chạy conformance  ", "source": "Goal", "objective": "chạy conformance"},
      {"prompt": "Goal: chạy conformance", "source": "Goal:", "objective": "chạy conformance"}
    ],
    "discussion": [
      "Goal nghĩa là gì?",
      "The Goal parser is documented here",
      "Goal"
    ],
    "scopeEscape": {"allowedPaths": ["scripts"], "path": "../RELEASE/WSR_MANIFEST.json"},
    "fallbackAdapter": "generic",
    "receiptContract": "goal-task-v1"
  },
  "approval": {
    "approved": ["ok", "làm đi", "DUYỆT", "ok duyệt", "Được rồi làm đi"],
    "discussion": ["được rồi", "ừ", "tiếp tục", "ok chưa?", "không, ok", "có nên làm đi"]
  },
  "negative": [
    "duplicate-rule-id",
    "manifest-command-registry",
    "resume-approval-field",
    "resume-path-escape",
    "router-bulk-load",
    "adapter-root-collision",
    "version-drift",
    "goal-path-escape",
    "goal-missing-receipt",
    "goal-definition-question"
  ]
}
