  "loadProfiles": {
    "startup": {
      "layers": [
        "kernel",
        "command_index"
      ],
      "maxTokens": 1000
    },
    "command": {
      "layers": [
        "kernel",
        "command_index",
        "active_workflow"
      ],
      "maxTokens": 1800
    },
    "task": {
      "layers": [
        "kernel",
        "command_index",
        "active_workflow",
        "matched_skills"
      ],
      "maxTokens": 6000
    },
    "resume": {
      "layers": [
        "kernel",
        "command_index",
        "session_descriptor",
        "session_references"
      ],
      "maxTokens": 4000
    },
    "diagnostic": {
      "layers": [
        "all_declared_artifacts"
      ],
      "maxTokens": 100000,
      "explicitOnly": true
    }
  },
  "precedenceRules": [
    "safety",
    "closest_project_rule",
    "active_workflow",
    "matched_skill",
    "resume_reference"
  ],
  "tokenBudget": {
    "estimator": "ceil(utf8_chars/4)",
    "enforcedPerProfile": true
  },
  "contextThreshold": {
    "warningPercent": 60,
    "handoffPercent": 75,
    "criticalPercent": 85,
    "action": "checkpoint_then_stop"
  },
  "contextTelemetry": {
    "reportEveryResponse": true,
    "lineFormat": "[Context: ~X% | Tr\u1ea1ng th\u00e1i: ...]",
    "measurementPriority": [
      "native",
      "estimate"
    ],
    "fallback": "estimate",
    "preflight": {
      "enabled": true,
      "warningPercent": 60,
      "safetyMarginPercent": 5
    }
  },
  "projectOverlayContract": {
    "enabled": true,
    "overlayPath": ".agents/WSR_ACTIVE.json"
  },
  "policyFile": "GEMINI.md",
  "resumeContract": {
    "schema": "schemas/wsr-session-v1.schema.json",
    "defaultPath": ".agents/memory/wsr-session.json",
    "approvalPersistence": false,
    "workspaceContainmentRequired": true
  },
  "goalContract": {
    "schema": "schemas/wsr-goal-v1.schema.json",
    "parser": "scripts/wsr_common.py:parse_goal_prompt",
    "receiptContract": "goal-task-v1",
    "autoCheckpointApproval": true,
    "backupResponsibility": "user"
  },
  "nativeContracts": {
    "codex": {
      "router": "~/.codex/AGENTS.md",
      "skills": "~/.agents/skills",
