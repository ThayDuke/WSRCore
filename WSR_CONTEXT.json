      "workspaceWorkflows": ".agents/workflows",
      "workspaceSkills": ".agents/skills",
      "maxRuleChars": 12000,
      "maxWorkflowChars": 12000,
      "goalSupport": "native",
      "goalEntrypoint": "native-goal",
      "subagentDispatch": true,
